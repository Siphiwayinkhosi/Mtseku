{
  "name": "mtseku",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.js",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/booking"]
  },
  "ratelimits": [
    {
      "name": "BOOKING_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 6, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "BOOKING_DELIVERY", "class_name": "BookingDelivery" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BookingDelivery"] }]
}
